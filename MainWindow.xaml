<Window x:Class="WpfHackthon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfHackthon"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="iPort Dock Manager" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="/Assets/Font/Montserrat/static/#Montserrat" ResizeMode="NoResize" Icon="/Assets/Img/Logo_iPortSolutions.ico">

    <Window.Resources>
        <Style TargetType="Button" x:Key="BaseButton">
            <Setter Property="Background" Value="#005094"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="/Assets/Font/Montserrat/static/#Montserrat"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#003D73"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>
        <Style TargetType="Button" x:Key="OrangeButton" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#f58220"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D86F1A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="RedButton" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#005094" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Dock Manager" 
                           Foreground="White" 
                           FontSize="22" 
                           FontWeight="Bold"
                           VerticalAlignment="Center" 
                           Margin="15,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,15,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Button Name="BtnCarregarMapeamento" Click="BtnCarregarMapeamento_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileUploadOutline" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Carregar Pátio"/>
                        </StackPanel>
                    </Button>
                    <Button Name="BtnSalvar" Click="BtnSalvar_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Salvar Alterações"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Name="TxtStatusEspaco" DockPanel.Dock="Bottom" Text="Pátio: 0 / 48" 
                           Margin="5,10,0,0" FontSize="14" Foreground="#555"/>
                <DataGrid Name="dataGridContainers" Margin="0,10,0,0" 
          IsReadOnly="True" 
          CanUserAddRows="False"
          AutoGenerateColumns="False"  PreviewKeyDown="dataGridContainers_PreviewKeyDown" 
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal" 
          HorizontalGridLinesBrush="#EEE"
          BorderThickness="1" 
          BorderBrush="#DDD" 
          Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Container" Binding="{Binding container}" FontWeight="SemiBold" Width="*"/>
                        <DataGridTextColumn Header="Saída" Binding="{Binding saida, StringFormat=d}" Width="Auto"/>
                        <DataGridTextColumn Header="Entrada" Binding="{Binding entrada, StringFormat=d}" Width="Auto"/>
                        <DataGridTextColumn Header="Bay" Binding="{Binding bay}" Width="50"/>
                        <DataGridTextColumn Header="Row" Binding="{Binding row}" Width="50"/>
                        <DataGridTextColumn Header="Tier" Binding="{Binding tier}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Border Grid.Column="1" Background="#F7F7F7" CornerRadius="5" Padding="15">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="10" Color="#DDD" Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Name="BtnOrganizar" Click="BtnOrganizar_Click" Style="{StaticResource OrangeButton}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Sync" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Otimizar Pátio"/>
                            </StackPanel>
                        </Button>
                        <Button Name="BtnDesfazer" Click="BtnDesfazer_Click" Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Undo" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Desfazer"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <GroupBox Header="Gerenciamento de Container" Margin="0,15,0,0" Padding="10" FontWeight="SemiBold" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Text="Container ID:" Margin="0,0,0,2" Foreground="#555"/>
                            <TextBox Name="TxtContainerId" Margin="0,0,0,10" Padding="8"/>
                            <TextBlock Text="Data de Entrada:" Margin="0,0,0,2" Foreground="#555"/>
                            <DatePicker Name="DpDataEntrada" Margin="0,0,0,10"/>
                            <TextBlock Text="Data de Saída Planejada:" Margin="0,0,0,2" Foreground="#555"/>
                            <DatePicker Name="DpDataSaida" Margin="0,0,0,5"/>
                        </StackPanel>
                    </GroupBox>

                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Name="BtnIncluir" Click="BtnIncluir_Click" Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="PlusBox" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Incluir"/>
                            </StackPanel>
                        </Button>
                        <Button Name="BtnCarregar" Click="BtnCarregar_Click" Grid.Row="0" Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Magnify" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Buscar"/>
                            </StackPanel>
                        </Button>
                        <Button Name="BtnEditar" Click="BtnEditar_Click" Grid.Row="1" Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Pencil" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Editar"/>
                            </StackPanel>
                        </Button>
                        <Button Name="BtnRetirar" Click="BtnRetirar_Click" Grid.Row="1" Grid.Column="1" Style="{StaticResource RedButton}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Delete" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Retirar"/>
                            </StackPanel>
                        </Button>
                        <Button Name="BtnPlanos1" Click="BtnPlanos1_Click" Grid.Row="2" Grid.ColumnSpan="2">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FileDocumentOutline" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Gerar Plano de Retirada"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>